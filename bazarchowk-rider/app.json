{
  "expo": {
    "name": "bazarchowk-rider",
    "slug": "bazarchowk-rider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/APP-ICON.png",
    "scheme": "bazarchowkrider",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/APP-ICON.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/APP-ICON.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/APP-ICON.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "android": {
            "image": "./assets/images/splash-screeb.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
